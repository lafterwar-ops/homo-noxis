# -*- coding: utf-8 -*-
import io

path = 'chapter1-ascension.tex'
s = io.open(path, encoding='utf-8').read()

# =====================================================================
# VIOLATION A1 + ROOM SCENE 1
# The old opening: K addresses Paul, laughs at the window/mountain,
# describes snow/postcards/glass boxes (outside knowledge in K's mouth).
# Replace the whole opening block (from "You keep asking me where it
# begins, Paul." through the "eyes of a boy who believed..." para,
# ending before the first \ornament at line 23) with:
#   - a Room Scene 1 (Paul present-tense: window, ski lift TRUTH,
#     Horizon LIE), then \ornament into K's narration proper.
# =====================================================================

old_open_start = "You keep asking me where it begins, Paul.\\par"
old_open_end   = "Everything I am about to describe, I saw with the eyes of a boy who believed that brightness was a kind of virtue.\\par"

i0 = s.index(old_open_start)
i1 = s.index(old_open_end) + len(old_open_end)
old_open_block = s[i0:i1]

# The epigraph + first \ornament sit ABOVE i0. After the epigraph's
# \ornament we currently drop straight into K. We want ROOM first.
# So we insert Room Scene 1 BEFORE K begins, then an \ornament, then K.

room1 = (
"He looks to the window before he speaks. I let him. The light off the glass "
"is bad this morning, flat and white, and I know what he sees in it.\\par\n\n"
"``There it is again,'' he says. ``Your mountain.'' He does not laugh, though "
"the first day he did, and was kind enough to be embarrassed by it. ``It is the "
"wrong kind. Made of snow. And it carries people to the top in little glass "
"boxes, and brings them down again, unharmed, in time to eat.'' He watches a "
"pair of the cabins climb the far slope. ``What are they.''\\par\n\n"
"``A lift,'' I say. ``A cable, and cars hung from it. It carries people up so "
"they may stand in the snow, and then it carries them down. That is all it is.'' "
"The truth is the cheapest thing on the table, so I give it to him whole; a lie "
"would cost more than the thing is worth.\\par\n\n"
"``To stand in the snow,'' he repeats, filing it somewhere. ``And be returned.'' "
"He turns from the window to the machine, and then to me. ``Yours announces "
"itself,'' he says. ``Mine spent a thousand years learning not to be found.''\\par\n\n"
"I do not answer that, which he permits.\\par\n\n"
"``Paul.'' He says my name the way he sets everything down, exactly, so he can "
"find it later. ``The people I was sent to. The ones the work is for. Are you "
"one of them.''\\par\n\n"
"``I am,'' I say.\\par\n\n"
"He nods, satisfied, and I let the two reels turn between us and hold my face "
"still, because it is the easiest lie I have told him and he has walked straight "
"past it without a mark.\\par\n\n"
"``Then begin where it begins,'' I say.\\par\n\n"
"\\ornament\n\n"
)

# K's narration now opens without the outside-world window paragraph.
# Keep his tape-fear passage and the "no such thing as a beginning" turn,
# but strip the snow/postcards paragraph. Rebuild the opening of his account.
kail_open = (
"There is no beginning. You keep asking me for one, Paul, and there is no "
"such thing; the beginning is always one chapter too far back and never quite "
"far enough, and I was taught to say so by people who did not want beginnings "
"examined. So I will not give you a beginning. I will give you a morning. The "
"morning the Mountain opened my hand and told me my name, and I was young "
"enough to believe that being named was the same as being freed.\\par\n\n"
"You have a machine on the table between us. A small wheel of tape that turns "
"when I speak and stops when I stop, and you have told me, twice now, that it "
"is only so you will not have to trust your memory. I believe you. But "
"understand what you are asking of me. I come from a place where memory was an "
"office, guarded and rationed and punished when it wandered. And here you sit, "
"letting a recorded voice run as though sound were a safe thing. As though a "
"voice could not be carried out of a room and used against the throat that made "
"it.\\par\n\n"
"That is the first thing you should learn about where I come from, before any "
"of the rest. Not the darkness. Not the stone. This: that we did not fear "
"seeing. We feared \\textit{carrying}. A man could look upon anything, so long "
"as he left it where it lay. The crime was never the eye. The crime was the "
"hand that took the thing away.\\par\n\n"
"I was fifteen. Hold on to that. Everything I am about to describe, I saw with "
"the eyes of a boy who believed that brightness was a kind of virtue.\\par"
)

s = s[:i0] + room1 + kail_open + s[i1:]

# =====================================================================
# VIOLATION A2 + ROOM SCENE 2
# Remove K's museum paragraph (line 33). Move its content to Paul.
# The Pendulum passage ends "...come back to itself, as though the Hall
# had spent all that time chewing one invisible circle.\par" and is
# immediately followed by K's museum line. We cut into it with an
# \ornament -> Room Scene 2 (Paul: TRUTH about museums; K discovers
# "museum") -> \ornament -> narration resumes at "Around the cleared..."
# =====================================================================

museum_k = (
"I have since learned that men in your world build such things in museums, "
"Paul, and put a little rope around them, and a card explaining the rotation "
"of the Earth. You send schoolchildren to watch. We knelt to it. I am not yet "
"certain which of us was more foolish.\\par"
)
assert s.count(museum_k) == 1, "museum_k not unique"

room2 = (
"\\ornament\n\n"
"``I know the thing you are describing,'' I say, when he has finished with the "
"disk. He stops, surprised that I would. ``We keep them. A great one hangs in a "
"hall of glass, from a wire, and swings exactly as you say, and turns across the "
"floor across a day. There is a rope around it, so no one may step near. And a "
"small card on a stand that explains it --- that it is the Earth turning beneath "
"the weight, not the weight that wanders.'' I let that sit. ``Schoolchildren are "
"sent to watch it. They are bored. Then they are made to write about it after.''\\par\n\n"
"He is very still. ``A hall of glass,'' he says. ``With a rope. So that it is "
"seen and not touched.'' Something moves behind his eyes that I do not name for "
"him. ``What is the hall called.''\\par\n\n"
"``A museum,'' I say. ``A house where a people keep the things they no longer "
"use, so the young may look at them and know they came from somewhere.''\\par\n\n"
"``A house for things you have finished with,'' he says slowly. ``And you rope "
"them off, and explain them on a card, and send your children to be bored by "
"them.'' He does not say the rest, and I do not help him to it: that his people "
"knelt to the same weight in the dark, and called it God's, and mine set it "
"behind a rope and called it the turning of the Earth. He only looks at me for a "
"moment, and I keep the account moving before the look can become a question I "
"would have to answer.\\par\n\n"
"``Go on,'' I say. ``You had knelt.''\\par\n\n"
"\\ornament\n\n"
)

s = s.replace(museum_k, room2.rstrip("\n"))

# =====================================================================
# VIOLATION A3 + ROOM SCENE 3
# A3: cut "exile, and your country, and a great deal of quiet reading"
#     clause from line ~81. Keep "It would be years before I understood".
# =====================================================================
exile_old = "It would be years --- it would be exile, and your country, and a great deal of quiet reading in rooms with too many windows --- before I understood"
exile_new = "It would be years before I understood"
assert s.count(exile_old) == 1, "exile clause not found uniquely"
s = s.replace(exile_old, exile_new)

# ROOM SCENE 3 replaces the line-53 aside:
#   "You will want me to explain that, Paul. I can see it in your face. But if
#   I explain it now, at the start, I will spoil the only thing worth telling
#   you, which is how long it took me to understand what it cost. Let it stand
#   for the moment as a song. It will become a wound later. Everything in the
#   Mountain did.\par"
# This aside sits AFTER the second scripture block. We replace it with:
#   \ornament -> Room Scene 3 (Paul knows the line = tell; K NOXIS-deflects)
#   -> \ornament -> narration resumes.
aside_old = (
"You will want me to explain that, Paul. I can see it in your face. But if I "
"explain it now, at the start, I will spoil the only thing worth telling you, "
"which is how long it took me to understand what it cost. Let it stand for the "
"moment as a song. It will become a wound later. Everything in the Mountain "
"did.\\par"
)
assert s.count(aside_old) == 1, "line-53 aside not found; check em-dash/spacing"

room3 = (
"\\ornament\n\n"
"``Let no one hand hold the whole,'' I say.\\par\n\n"
"He looks up from the machine. I had not meant to say it aloud, and I let him "
"believe I had not, though I said it exactly, in its measure, the way it is "
"sung and not the way a man repeats a thing he has only heard once.\\par\n\n"
"``You know the line,'' he says. It is not quite a question.\\par\n\n"
"``It is written where I am from,'' I say. That much is true, and it is all I "
"give him.\\par\n\n"
"He watches me for a moment, the way he watches the window. ``You will want me "
"to explain it,'' he says. ``I can see it in your face. But if I explain it "
"now, at the start, I spoil the only thing worth telling you --- which is how "
"long it took me to understand what it cost. Let it stand for now as a song. It "
"will become a wound later. Everything in the Mountain did.''\\par\n\n"
"I do not press him. A man who withholds is a man still deciding what he will "
"give, and I have learned to let such men run until they forget I am counting. "
"I nod, and turn the reels, and say nothing, which is its own kind of "
"agreement --- and I do not tell him that I know the line already, better than "
"a servant of record and sequence has any business knowing it.\\par\n\n"
"\\ornament\n\n"
)

s = s.replace(aside_old, room3.rstrip("\n"))

# =====================================================================
# VIOLATION A4 + ROOM SCENE 4 (the ending)
# Replace the whole closing block (from "You have stopped the tape, Paul."
# through "Write to your Cl\'ementine while you still can say you knew
# nothing.\par") with a reframed Room Scene 4 in Paul's present tense.
# The final \ornament stays as the last line.
# =====================================================================

close_start = "You have stopped the tape, Paul. I noticed."
# find the last \par before the final \ornament
i_cs = s.index(close_start)
# The block runs to just before the trailing "\n\n\\ornament" at EOF.
# Locate the final \ornament.
i_last_orn = s.rindex("\\ornament")
close_block = s[i_cs:i_last_orn]

room4 = (
"I stop the tape. I do not decide to; my hand does it, and he sees the reels "
"go still, and he sees me see him see it.\\par\n\n"
"``You stopped it,'' he says. He is not troubled. He is almost gentle. ``You "
"do that when you are afraid of what you want to ask next.''\\par\n\n"
"I do not tell him what I want to ask. I lean in instead, which is answer "
"enough, and he takes it as the sign to go on --- to give me the whole of it, "
"the shape under the ceremony, the thing the bowl was calling to and the reason "
"five hands were never permitted to hold one thing between them.\\par\n\n"
"``I will tell you all of it,'' he says. ``That is why I was sent. You are "
"Horizon; the account is yours by right, and a thing given to its own people is "
"not carried anywhere it should not go.'' He says it plainly, without weight, "
"the way a man says a thing he has stopped needing to check. ``What my whole "
"world was built to keep from wandering, I will lay in your hands, and you will "
"hold the whole of it, because you are the one place it is safe.''\\par\n\n"
"He believes that. I can see that he believes it. He gives me the thing his "
"people would kill to keep from crossing a threshold, and he gives it freely, "
"and without fear, because he is certain he is handing it home.\\par\n\n"
"``Start the tape again, Paul,'' he says. ``I have only reached the naming. "
"There is so much more you will want.''\\par\n\n"
"I start the tape. The reels turn. I keep my face as still as the stone he "
"knelt on, and I let him begin to give me everything.\\par\n\n"
)

s = s[:i_cs] + room4 + s[i_last_orn:]

# =====================================================================
# NUL strip + write
# =====================================================================
s = s.replace(chr(0), '')

io.open(path, 'w', encoding='utf-8', newline='\n').write(s)
print("WROTE OK")
